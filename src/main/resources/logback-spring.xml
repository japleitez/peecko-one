<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration scan="true">

    <!-- ===================================================================
         Conversion Rules
         =================================================================== -->
    <conversionRule conversionWord="crlf" converterClass="com.peecko.one.config.CRLFLogConverter" />

    <!-- ===================================================================
         Log Patterns
         =================================================================== -->
    <!-- Console pattern (colourised) -->
    <property name="CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %crlf(%m){red} %n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <!-- File pattern (plain text, no ANSI codes) -->
    <property name="FILE_LOG_PATTERN"
              value="${FILE_LOG_PATTERN:-%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %crlf(%m) %n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <!-- ===================================================================
         Spring Boot defaults (colour converters, etc.)
         =================================================================== -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ===================================================================
         Library / framework logger levels  (shared by all profiles)
         =================================================================== -->
    <logger name="angus.activation"                                         level="WARN"/>
    <logger name="jakarta.activation"                                       level="WARN"/>
    <logger name="jakarta.mail"                                             level="WARN"/>
    <logger name="jakarta.management.remote"                                level="WARN"/>
    <logger name="jakarta.xml.bind"                                         level="WARN"/>
    <logger name="jdk.event.security"                                       level="INFO"/>
    <logger name="com.ryantenney"                                           level="WARN"/>
    <logger name="com.sun"                                                  level="WARN"/>
    <logger name="com.zaxxer"                                               level="WARN"/>
    <logger name="io.undertow"                                              level="WARN"/>
    <logger name="io.undertow.websockets.jsr"                               level="ERROR"/>
    <logger name="org.ehcache"                                              level="WARN"/>
    <logger name="org.apache"                                               level="WARN"/>
    <logger name="org.apache.catalina.startup.DigesterFactory"              level="OFF"/>
    <logger name="org.bson"                                                 level="WARN"/>
    <logger name="org.hibernate.validator"                                  level="WARN"/>
    <logger name="org.hibernate"                                            level="WARN"/>
    <logger name="org.hibernate.ejb.HibernatePersistence"                   level="OFF"/>
    <logger name="org.postgresql"                                           level="WARN"/>
    <logger name="org.springframework"                                      level="WARN"/>
    <logger name="org.springframework.web"                                  level="WARN"/>
    <logger name="org.springframework.security"                             level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure.logging"           level="INFO"/>
    <logger name="org.springframework.cache"                                level="WARN"/>
    <logger name="org.thymeleaf"                                            level="WARN"/>
    <logger name="org.xnio"                                                 level="WARN"/>
    <logger name="io.swagger.v3"                                            level="INFO"/>
    <logger name="sun.rmi"                                                  level="WARN"/>
    <logger name="sun.rmi.transport"                                        level="WARN"/>
    <!-- https://github.com/jhipster/generator-jhipster/issues/13835 -->
    <logger name="Validator"                                                level="INFO"/>
    <!-- https://github.com/jhipster/generator-jhipster/issues/14444 -->
    <logger name="_org.springframework.web.servlet.HandlerMapping.Mappings" level="INFO"/>
    <logger name="liquibase"                                                level="WARN"/>
    <logger name="LiquibaseSchemaResolver"                                  level="INFO"/>

    <!-- ===================================================================
         JUL → SLF4J bridge
         =================================================================== -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <!-- ===================================================================
         PROFILE: default  (no Spring profile active)
         - Console only, INFO level
         =================================================================== -->
    <springProfile name="default">

        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <springProperty name="log.level" source="logging.level.root" defaultValue="INFO"/>
        <root level="${log.level}">
            <appender-ref ref="CONSOLE"/>
        </root>

    </springProfile>

    <!-- ===================================================================
         PROFILE: dev
         - Console (colourised) + rolling file
         - DEBUG level for application packages, INFO root
         - Small file size limit, short retention (keep local disk tidy)
         =================================================================== -->
    <springProfile name="dev">

        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <appender name="DEV_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/dev/pck_admin.log</file>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- Roll over daily and when the file reaches 20 MB -->
                <fileNamePattern>logs/dev/pck_admin.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <!-- Keep 7 days / 200 MB total -->
                <maxHistory>7</maxHistory>
                <totalSizeCap>200MB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="ASYNC_DEV_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="DEV_FILE"/>
        </appender>

        <!-- Verbose logging for the application's own packages in dev -->
        <logger name="com.peecko.one" level="DEBUG"/>

        <springProperty name="log.level" source="logging.level.root" defaultValue="INFO"/>
        <root level="${log.level}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_DEV_FILE"/>
        </root>

    </springProfile>

    <!-- ===================================================================
         PROFILE: stage
         - Console + rolling file
         - INFO level; WARN for noisy framework classes
         - Medium file size / retention (mirrors production behaviour)
         =================================================================== -->
    <springProfile name="stage">

        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <appender name="STAGE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/stage/pck_admin.log</file>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- Roll over daily and when the file reaches 50 MB -->
                <fileNamePattern>logs/stage/pck_admin.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <!-- Keep 14 days / 1 GB total -->
                <maxHistory>14</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="ASYNC_STAGE_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="STAGE_FILE"/>
        </appender>

        <!-- Application packages at INFO in staging -->
        <logger name="com.peecko.one" level="INFO"/>

        <springProperty name="log.level" source="logging.level.root" defaultValue="INFO"/>
        <root level="${log.level}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_STAGE_FILE"/>
        </root>

    </springProfile>

    <!-- ===================================================================
         PROFILE: prod
         - File only (no console), WARN root level
         - Larger file size, longer retention, gzip compression
         - Async appender with larger queue for high-throughput environments
         =================================================================== -->
    <springProfile name="prod">

        <appender name="PROD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/prod/pck_admin.log</file>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- Roll over daily and when the file reaches 100 MB -->
                <fileNamePattern>logs/prod/pck_admin.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <!-- Keep 30 days / 5 GB total -->
                <maxHistory>30</maxHistory>
                <totalSizeCap>5GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="ASYNC_PROD_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <!-- Larger queue for high-throughput production workloads -->
            <queueSize>1024</queueSize>
            <!-- Never discard WARN/ERROR events (0 = discard nothing) -->
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="PROD_FILE"/>
        </appender>

        <!-- Keep application logs at INFO even when root is WARN -->
        <logger name="com.peecko.one" level="INFO"/>

        <springProperty name="log.level" source="logging.level.root" defaultValue="WARN"/>
        <root level="${log.level}">
            <!-- No CONSOLE appender in production -->
            <appender-ref ref="ASYNC_PROD_FILE"/>
        </root>

    </springProfile>

</configuration>
