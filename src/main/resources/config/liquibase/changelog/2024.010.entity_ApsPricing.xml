<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="2024-010-ApsPricing-sequence" author="jhipster">
        <createSequence sequenceName="aps_pricing_seq" startValue="1000" incrementBy="50"/>
    </changeSet>

    <changeSet id="2024-010-ApsPricing-entity" author="jhipster">
        <createTable tableName="aps_pricing">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country" type="varchar(2)">
                <constraints nullable="false" />
            </column>
            <column name="customer_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="index" type="integer">
                <constraints nullable="false" />
            </column>
            <column name="min_quantity" type="integer">
                <constraints nullable="false" />
            </column>
            <column name="unit_price" type="double">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>


</databaseChangeLog>
