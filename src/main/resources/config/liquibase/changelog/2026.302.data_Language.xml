<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Seeds the language table with the codes of the former Language enumeration (AA, EN, FR, DE, ES, IT),
        in the same order. Runs in every context, but only when the table is still empty.
    -->
    <changeSet id="2026-302-Language-data" author="jhipster">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM language</sqlCheck>
        </preConditions>
        <insert tableName="language">
            <column name="id" valueNumeric="1"/>
            <column name="code" value="AA"/>
            <column name="name" value="AA"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="language">
            <column name="id" valueNumeric="2"/>
            <column name="code" value="EN"/>
            <column name="name" value="English"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="language">
            <column name="id" valueNumeric="3"/>
            <column name="code" value="FR"/>
            <column name="name" value="French"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="language">
            <column name="id" valueNumeric="4"/>
            <column name="code" value="DE"/>
            <column name="name" value="German"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="language">
            <column name="id" valueNumeric="5"/>
            <column name="code" value="ES"/>
            <column name="name" value="Spanish"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="language">
            <column name="id" valueNumeric="6"/>
            <column name="code" value="IT"/>
            <column name="name" value="Italian"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="language">
            <column name="id" valueNumeric="7"/>
            <column name="code" value="PT"/>
            <column name="name" value="Portuguese"/>
            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
