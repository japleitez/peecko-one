<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="2024-113-Invoice-number-unique" author="jhipster">
        <addUniqueConstraint tableName="invoice"
                             columnNames="number"
                             constraintName="uc_invoice_number"/>
    </changeSet>

    <changeSet id="2024-113-Invoice-constraint" author="jhipster">
        <addForeignKeyConstraint baseColumnNames="aps_order_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__aps_order_id"
                                 referencedColumnNames="id"
                                 referencedTableName="aps_order"
                                 />
    </changeSet>

</databaseChangeLog>
