<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ApsPlan.
    -->
    <changeSet id="2024-006-1" author="jhipster">
        <createTable tableName="aps_plan">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country" type="varchar(2)">
                <constraints nullable="false" />
            </column>
            <column name="agency_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="customer_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="contract" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="pricing" type="varchar(12)">
                <constraints nullable="false" />
            </column>
            <column name="state" type="varchar(12)">
                <constraints nullable="false" />
            </column>
            <column name="license" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="starts" type="date">
                <constraints nullable="false" />
            </column>
            <column name="ends" type="date">
                <constraints nullable="true" />
            </column>
            <column name="unit_price" type="double">
                <constraints nullable="false" />
            </column>
            <column name="notes" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="created" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="updated" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="aps_plan" columnName="created" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="aps_plan" columnName="updated" columnDataType="${datetimeType}"/>
    </changeSet>

</databaseChangeLog>
