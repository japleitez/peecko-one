<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="2024-019-VideoItem-sequence" author="jhipster">
        <createSequence sequenceName="video_item_seq" startValue="1000" incrementBy="50"/>
    </changeSet>

    <changeSet id="2024-019-VideoItem-entity" author="jhipster">
        <createTable tableName="video_item">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(100)">
                <constraints nullable="true" />
            </column>
            <column name="next_video_item_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="previous_video_item_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="play_list_id" type="bigint">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
