<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2024-115-ApsPlan-contract-unique" author="jhipster">
        <addUniqueConstraint tableName="aps_plan"
                             columnNames="contract"
                             constraintName="uc_aps_plan_contract"/>
    </changeSet>

    <changeSet id="2024-105-ApsPlan-constraint" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="customer_id"
                                 baseTableName="aps_plan"
                                 constraintName="fk_aps_plan__customer_id"
                                 referencedColumnNames="id"
                                 referencedTableName="customer"
                                 />
    </changeSet>

</databaseChangeLog>
